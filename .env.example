# ─────────────────────────────────────────────────────────────
# Hala Technology — environment variables
#
# Copy to `.env.local` and fill in real values. `.env.local` is gitignored.
# Only variables listed here are read by the application; do not reintroduce
# credentials for services the app does not use (see AUDIT-2026-10-14.md H2).
# ─────────────────────────────────────────────────────────────

# ─── reCAPTCHA v2 (required in production) ────────────────────
# The booking endpoint fails CLOSED: if the secret is missing in production it
# returns 503 rather than accepting unverified submissions.
NEXT_PUBLIC_RECAPTCHA_SITE_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
RECAPTCHA_SECRET_KEY=6Lxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── Email (Resend) ───────────────────────────────────────────
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ─── CRM webhook (Pabbly Connect) ─────────────────────────────
# Unauthenticated ingestion endpoint — treat as a secret. There is deliberately
# no hardcoded fallback in the source; if this is unset, leads are not forwarded.
PABBLY_WEBHOOK_URL=https://connect.pabbly.com/webhook-listener/webhook/xxxxxxxx

# ─── Sanity CMS ───────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=your_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-02-18
# Shared secret for the /api/revalidate webhook. Must be high-entropy random —
# generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# and set the SAME value in Sanity → API → Webhooks.
SANITY_REVALIDATE_SECRET=generate_a_32_byte_random_hex_string

# ─── Rate limiting (optional, strongly recommended) ───────────
# Without these the booking rate limiter is per-instance only and will not hold
# across serverless invocations. A free Upstash Redis database is sufficient.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Set to "true" ONLY if Cloudflare genuinely fronts this deployment. Otherwise
# cf-connecting-ip and x-forwarded-for are client-spoofable and would let an
# attacker mint unlimited fresh rate-limit buckets.
TRUST_CLOUDFLARE_HEADERS=false

# ─── Error monitoring (optional) ──────────────────────────────
# Leave unset to disable Sentry entirely — the SDK stays a no-op.
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
